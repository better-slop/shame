{
  "name": "@bs-shame/auth",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "auth:generate": "bunx @better-auth/cli@latest generate --input ./src/index.ts --output ../db/src/schema/auth.ts"
  },
  "dependencies": {
    "@bs-shame/db": "workspace:*",
    "@bs-shame/env": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@bs-shame/config": "workspace:*",
    "typescript": "catalog:"
  }
}
