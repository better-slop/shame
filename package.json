{
  "name": "bs-shame",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^5",
      "@types/node": "^22.13.14",
      "@cloudflare/workers-types": "^4.20251213.0",
      "@trpc/server": "^11.7.2",
      "better-auth": "^1.4.9",
      "alchemy": "^0.82.1",
      "wrangler": "^4.54.0",
      "@libsql/client": "0.15.15",
      "libsql": "0.5.22",
      "@trpc/client": "^11.7.2",
      "drizzle-orm": "^0.45.1"
    }
  },
  "type": "module",
  "scripts": {
    "auth:generate": "bun run --filter @bs-shame/auth auth:generate",
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types",
    "dev:native": "bun run --filter native dev",
    "dev:web": "bun run --filter web dev",
    "dev:server": "bun run --filter server dev",
    "db:push": "bun run --filter @bs-shame/db db:push",
    "db:generate": "bun run --filter @bs-shame/db db:generate",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@bs-shame/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@bs-shame/config": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "^0.19.0",
    "oxlint": "^1.34.0",
    "typescript": "catalog:"
  },
  "overrides": {
    "libsodium-wrappers": "0.7.15"
  },
  "packageManager": "bun@1.3.5"
}
